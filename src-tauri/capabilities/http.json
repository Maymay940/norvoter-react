{
  "identifier": "http-requests",
  "description": "Allow HTTP requests to backend",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:8001" },
        { "url": "http://localhost:8001/**" },
        { "url": "http://127.0.0.1:8001" },
        { "url": "http://127.0.0.1:8001/**" }
      ]
    }
  ]
}